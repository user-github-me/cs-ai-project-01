<text x="386" y="58" font-size="12" fill="#2A2F5E" text-anchor="start" font-weight="600" font-family="Menlo, monospace">circle</text>
<text x="386" y="74" font-size="12" fill="#2A2F5E" text-anchor="start" font-weight="400" font-family="Menlo, monospace">&#160;&#160;centre:&#160;(60,&#160;60)</text>
